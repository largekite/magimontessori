// Generated by Skylia AI Builder — MagiMontessori
// DO NOT EDIT MANUALLY — regenerate via the Skylia dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// Platform users synced from Clerk
model User {
  id         String   @id @default(cuid())
  clerkId  String @unique
  email  String @unique
  name  String?
  avatarUrl  String?
  stripeCustomerId  String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  subscriptionId  String?
  subscriptionStatus  String?
  currentPeriodEnd  DateTime?
  workspacemembers  WorkspaceMember[]
}

// Family or classroom workspace — top-level tenant
model Workspace {
  id         String   @id @default(cuid())
  name  String
  slug  String @unique
  plan  String @default("free")
  logoUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspacemembers  WorkspaceMember[]
  subscriptions  Subscription[]
  childprofiles  ChildProfile[]
}

// User membership in a workspace with role
model WorkspaceMember {
  id         String   @id @default(cuid())
  workspaceId  String
  userId  String
  role  String @default("member")
  joinedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stripe subscription per workspace
model Subscription {
  id         String   @id @default(cuid())
  workspaceId  String
  stripeSubscriptionId  String @unique
  stripePriceId  String
  status  String
  seatCount  Int @default(1)
  currentPeriodEnd  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Individual child learner profile within a workspace
model ChildProfile {
  id         String   @id @default(cuid())
  workspaceId  String
  name  String
  dateOfBirth  DateTime?
  avatarUrl  String?
  interests  Json?
  montessoriLevel  String @default("toddler")
  totalBooksRead  Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learningbooks  LearningBook[]
}

// AI-generated personalized Montessori learning book for a child
model LearningBook {
  id         String   @id @default(cuid())
  workspaceId  String
  childProfileId  String
  title  String
  topic  String
  montessoriArea  String
  ageGroup  String
  content  Json
  coverImageUrl  String?
  status  String @default("draft")
  completedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  childprofile  ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  activitycards  ActivityCard[]
}

// Printable Montessori activity card linked to a learning book
model ActivityCard {
  id         String   @id @default(cuid())
  bookId  String
  title  String
  instructions  String
  materials  Json?
  montessoriArea  String
  difficulty  String @default("beginner")
  printableUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  learningbook  LearningBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
}
